# Copy to .env and set your own password before starting Docker Compose.
COMPOSE_PROJECT_NAME=boss-pay-up
DB_NAME=reimbursement_db
DB_USER=reimbursement_user
DB_PASSWORD=replace-with-your-own-database-password
WEB_PORT=8080
# Browser origins, separated by commas. Include the port when nonstandard.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Set to 1 only when accessing the application through HTTPS.
COOKIE_SECURE=0
